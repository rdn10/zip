# PaddleOCR local (sem chave de API). Se necessário, informe o caminho completo do Python 3.12.
# Exemplo: PADDLEOCR_PYTHON=C:\Users\SeuUsuario\AppData\Local\Programs\Python\Python312\python.exe
PADDLEOCR_PYTHON=
# auto escolhe GPU CUDA compatível quando disponível; caso contrário usa CPU.
PADDLEOCR_DEVICE=auto
# Tempo máximo para importar os modelos e iniciar o worker (5 minutos).
PADDLEOCR_STARTUP_TIMEOUT_MS=300000
# Tempo máximo para leitura de cada PDF (5 minutos).
PADDLEOCR_TIMEOUT_MS=300000

# RapidOCR local opcional (mesmo Python do PaddleOCR por padrão).
# Configure apenas se o ambiente Python do RapidOCR for diferente.
RAPIDOCR_PYTHON=
RAPIDOCR_CPU_THREADS=2
RAPIDOCR_STARTUP_TIMEOUT_MS=300000
RAPIDOCR_TIMEOUT_MS=900000

# App URL (only needed when hosted)
APP_URL="MY_APP_URL"
